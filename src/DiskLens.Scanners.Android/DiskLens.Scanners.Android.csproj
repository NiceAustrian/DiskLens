<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>30</SupportedOSPlatformVersion>
    <RootNamespace>DiskLens.Scanners.Droid</RootNamespace>
  </PropertyGroup>

  <!-- Local developer defaults; CI sets ANDROID_HOME / JAVA_HOME itself. -->
  <PropertyGroup>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and '$(ANDROID_HOME)' == '' and Exists('C:\Android\Sdk')">C:\Android\Sdk</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and '$(JAVA_HOME)' == '' and Exists('C:\Program Files\Eclipse Adoptium\jdk-21.0.7.6-hotspot')">C:\Program Files\Eclipse Adoptium\jdk-21.0.7.6-hotspot</JavaSdkDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DiskLens.Core/DiskLens.Core.csproj" />
  </ItemGroup>
</Project>
